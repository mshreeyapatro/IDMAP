# Copy this file to `.env` (same folder) and fill in your real key.
# .env is gitignored -- it never gets committed.

# Main IDMAP credentials. Keep your actual values in the untracked root `.env`.
# Get a Gemini key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
DATABASE_URL=
DIRECT_URL=

# Optional separate credentials for the Disaster Knowledge Assistant.
# Leave these blank to reuse GEMINI_API_KEY, DATABASE_URL, and DIRECT_URL above.
# If using a separate database, ASSISTANT_DIRECT_URL should be its direct/non-pooled URL.
ASSISTANT_GEMINI_API_KEY=
ASSISTANT_DATABASE_URL=
ASSISTANT_DIRECT_URL=

# Optional: defaults to this repository's data/ folder.
# DATA_DIR=
