# Copy this file to `.env` (same folder) and fill in your real key.
# .env is gitignored -- it never gets committed.

# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for the knowledge assistant's pgvector RAG index and feedback logs.
# DATABASE_URL and DIRECT_URL are also used by the main app's Prisma setup.
# DIRECT_URL is used for assistant schema setup and document ingestion.
DATABASE_URL=
DIRECT_URL=

# Optional: defaults to this repository's data/ folder.
# DATA_DIR=
