{
  "name": "idmap",
  "version": "2.0.0",
  "description": "IDMAP: Intelligent Disaster Mapping & Advisory Platform - Odisha Cyclone Intelligence",
  "private": true,
  "scripts": {
    "start": "node scripts/dev.js",
    "dev": "node scripts/dev.js",
    "backend": "python -m uvicorn backend.main:app --reload --port 8000",
    "frontend": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "install:frontend": "npm install --prefix frontend",
    "install:all": "npm run install:frontend && npm run install:python",
    "install:python": "python3 -m pip install -r requirements.txt",
    "assistant:db:init": "python3 -m src.knowledge_assistant.init_db",
    "assistant:ingest:dry": "python3 -m src.knowledge_assistant.ingest --dry-run",
    "assistant:ingest": "python3 -m src.knowledge_assistant.ingest",
    "assistant:curate:import": "python3 -m src.knowledge_assistant.curate import data/knowledge_base/curated_qa.jsonl"
  },
  "keywords": [
    "disaster-management",
    "cyclone-prediction",
    "multimodal-ai",
    "fastapi",
    "react",
    "odisha"
  ],
  "author": "IDMAP Team",
  "license": "UNLICENSED"
}
